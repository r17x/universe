# Ignore everything
*

# Top-level files
!.gitignore
!.gitattributes
!.sops.yaml
!BACALAH.md
!CLAUDE.md
!README.md
!flake.lock
!flake.nix
!r17.nix

# .claude - skill definitions
!.claude/
!.claude/**/
!.claude/**/*.md

# .github - CI workflows
!.github/
!.github/**/
!.github/**/*.yml

# nix - system configuration
!nix/
!nix/**/
!nix/**/*.nix
!nix/**/.gitignore
!nix/**/*.md
!nix/**/*.lua
!nix/**/*.c
!nix/**/*.h
!nix/**/*.json
!nix/**/makefile

# apps - applications
!apps/

# apps/norg - OCaml
!apps/norg/**/
!apps/norg/**/*.ml
!apps/norg/**/*.nix
!apps/norg/**/*.opam
!apps/norg/**/dune
!apps/norg/**/dune-project

# apps/rin.rocks - Reason + web
!apps/rin.rocks/**/
!apps/rin.rocks/**/*.re
!apps/rin.rocks/**/*.nix
!apps/rin.rocks/**/*.html
!apps/rin.rocks/**/*.json
!apps/rin.rocks/**/*.mjs
!apps/rin.rocks/**/*.ts
!apps/rin.rocks/**/dune
!apps/rin.rocks/**/dune-project
!apps/rin.rocks/**/.ocamlformat
!apps/rin.rocks/**/.yarnrc.yml
!apps/rin.rocks/**/yarn.lock

# apps/r17c - Rust embedded
!apps/r17c/
!apps/r17c/src/
!apps/r17c/src/*.rs
!apps/r17c/src/usb/
!apps/r17c/src/usb/*.rs
!apps/r17c/*.rs
!apps/r17c/*.toml
!apps/r17c/*.x
!apps/r17c/.cargo/
!apps/r17c/.cargo/config.toml
!apps/r17c/Cargo.lock
!apps/r17c/*.md
!apps/r17c/*.nu

# notes
!notes/
!notes/**/
!notes/**/*.norg

# secrets
!secrets/
!secrets/**/
!secrets/**/*.norg
!secrets/**/*.yaml
