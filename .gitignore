# Ignore everything
*

# Top-level files
!.gitignore
!.gitattributes
!.sops.yaml
!BACALAH.md
!CLAUDE.md
!README.md
!flake.lock
!flake.nix

# .claude - skill definitions
!.claude/
!.claude/**/
!.claude/**/*.md

# .github - CI workflows
!.github/
!.github/**/
!.github/**/*.yml

# nix - system configuration
!nix/
!nix/**/
!nix/**/*.nix
!nix/**/.gitignore
!nix/**/*.md
!nix/**/*.lua
!nix/**/*.c
!nix/**/*.h
!nix/**/*.json
!nix/**/makefile

# apps - applications (OCaml, Reason, web)
!apps/
!apps/**/
!apps/**/*.ml
!apps/**/*.re
!apps/**/*.nix
!apps/**/*.opam
!apps/**/*.html
!apps/**/*.json
!apps/**/*.mjs
!apps/**/*.ts
!apps/**/dune
!apps/**/dune-project
!apps/**/.ocamlformat
!apps/**/.yarnrc.yml
!apps/**/yarn.lock

# notes
!notes/
!notes/**/
!notes/**/*.norg

# secrets
!secrets/
!secrets/**/
!secrets/**/*.norg
!secrets/**/*.yaml
